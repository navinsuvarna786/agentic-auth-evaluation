# Layered Auth Ephemeral Agents — environment template
#
# Copy to .env (in this directory) and fill in values.
# .env is git-ignored. Never commit real secrets.
#
# All values shown below are example/dev values; rotate before any non-local use.

# --- Postgres backing Keycloak ---------------------------------------------
POSTGRES_PASSWORD=change_me_postgres

# --- Keycloak admin (used to bootstrap the realm at first start) ----------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# --- Agent OAuth client credentials ---------------------------------------
# CLIENT_SECRET is substituted into keycloak/realm-export.json at import time
# via Keycloak's ${env.VAR} placeholder. Must be a non-empty random string.
CLIENT_ID=agent-launcher
CLIENT_SECRET=change_me_agent_launcher_secret

# Internal API client secret (also substituted into realm-export.json)
INTERNAL_API_SECRET=change_me_internal_api_secret

# --- Security verification test clients (verify_security_claims.py) -------
# Two purpose-built Keycloak clients in the same realm, used only by the
# adversarial test harness — never by the benchmark workload.
#
# wrong-audience-client: no agent-scope → token's aud will not contain
#   "internal-api" → exercises S3 (audience mismatch → API returns 403).
WRONG_AUDIENCE_CLIENT_SECRET=change_me_wrong_audience_secret
# short-ttl-client: access.token.lifespan=10s → S5 sleeps ~12s instead of
#   the realm-default 5 min before sending the expired token.
SHORT_TTL_CLIENT_SECRET=change_me_short_ttl_secret

# --- Service URLs (override only when running multi-host) -----------------
# Defaults assume single-host docker compose on localhost.
# KEYCLOAK_URL=http://localhost:8081
# API_URL=http://localhost:8001
# REDIS_URL=redis://localhost:6379

# --- Realm / audience -----------------------------------------------------
# REALM_NAME=ephemeral-agents
# TARGET_AUDIENCE=internal-api
# EXPECTED_AUDIENCE=internal-api

# --- Workload generator (benchmark/workload.py) ---------------------------
# WORKLOAD_MODE selects which workload runs in the benchmark loop:
#   synthetic   — no LLM. RQ1 headline auth-overhead condition.
#   llm-direct  — agent → API → one chat completion. RQ2 realism context.
#   llm-chain   — RQ3 two-hop delegation under LLM load. B5b scope; not yet
#                 implemented.
# WORKLOAD_MODE=synthetic
#
# Required only for llm-* modes — point at the Cisco gateway:
# LLM_GATEWAY_URL=https://llm-gateway.example.com
# LLM_API_KEY=<gateway-jwt>
# LLM_MODEL=gpt-4.1-mini
# LLM_MAX_COMPLETION_TOKENS=30
#
# Token budget — hard caps enforced before each call. Defaults below sit
# safely inside the Cisco gateway's published limits (120K/min, 720K/hr,
# 7.2M/day prompt tokens) with a ~21% retry buffer on the daily figure:
# LLM_PER_MINUTE_TOKEN_BUDGET=18000
# LLM_PER_HOUR_TOKEN_BUDGET=720000
# LLM_PER_DAY_TOKEN_BUDGET=4750000
